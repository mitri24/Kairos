# ── Kairos deployment configuration ────────────────────────────────
# Copy to `.env` and adjust. docker compose reads `.env` automatically.
# Enthält Secrets (VAPID_PRIVATE_KEY) → nicht committen (via .gitignore) und
# `chmod 600 .env` setzen. Env-gesetzte Keys sind zudem in `docker inspect` sichtbar.

# Local day boundaries for the daily focus metrics.
TZ=Europe/Zurich

# ── Netzwerk / API-Zugriff ─────────────────────────────────────────
# Bind-Adresse des HTTP-Servers. Default 0.0.0.0 (nötig fürs Docker-Port-Mapping).
# Für lokalen Einzelnutzer-Betrieb mit sensiblen Health-Daten auf 127.0.0.1 setzen.
# HOST=127.0.0.1
# Erlaubte CORS-Origin für die API. Default "*" (PWA-/Extension-Kompatibilität).
# Auf die eigene Origin setzen oder leeren (CORS_ORIGIN=), um Cross-Origin-Lesen
# der (auch gesundheitsbezogenen) API-Antworten zu unterbinden.
# CORS_ORIGIN=*

# ── Reverse proxy (only used with:  docker compose --profile proxy up) ──
# REQUIRED for the proxy profile: a domain you OWN whose DNS A/AAAA record points
# at this host. Caddy requests a REAL Let's Encrypt certificate for it — do NOT
# leave a placeholder/example value (repeated ACME failures risk a rate-limit
# lockout). Uncomment and set your own:
#DOMAIN=kairos.example.com

# ── Web Push (VAPID) ───────────────────────────────────────────────
# OPTIONAL. Leave empty to let the server generate a key pair on first start
# and persist it in the database. Set fixed keys to keep push subscriptions
# valid across database resets. Generate a pair with:  npm run gen:vapid
# (or in-container — see docs/DEPLOY.md).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── App host binding (optional) ────────────────────────────────────
# Where the app's port is published on the host. Default: 127.0.0.1:4321
# (loopback only). Behind the proxy you can leave it — Caddy uses the internal
# network. Set to e.g. 0.0.0.0:4321 only if you deliberately want it public.
#APP_BIND=127.0.0.1:4321

# ── Authentifizierung / Multi-Tenant (Magic-Link) ──────────────────
# Die API ist jetzt hinter Login: jede Datenroute braucht eine gültige Sitzung
# (Cookie), Daten sind pro Nutzer isoliert. Login passwortlos per Magic-Link.
#
# E-Mail des Owner-Kontos, dem bestehende Single-Tenant-Daten bei der einmaligen
# Migration zugeordnet werden. Zum Zugriff auf diese Daten mit GENAU dieser
# Adresse einloggen. Default: owner@localhost
#OWNER_EMAIL=you@example.com
#
# Cookie-Absicherung. Hinter HTTPS (Proxy) auf 1 setzen → Secure-Flag.
#COOKIE_SECURE=1
#
# Magic-Link-Zustellung: Es ist KEIN Mailversand eingebaut (zero-dep). Der Link
# wird IMMER in die Server-Konsole geloggt. Für lokalen Self-Host wird er
# zusätzlich an localhost-Clients direkt in der Login-Maske angezeigt.
#   AUTH_DEV_LINK=1  → Link immer in der API-Antwort zurückgeben (nur Dev!)
#   AUTH_DEV_LINK=0  → nie zurückgeben (nur Konsole/Mail) — für Public-Deploy
#AUTH_DEV_LINK=0
