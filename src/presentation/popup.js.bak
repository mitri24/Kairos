const phaseLabel = document.getElementById("phaseLabel");
const statusLabel = document.getElementById("statusLabel");
const timeLabel = document.getElementById("timeLabel");
const cycleLabel = document.getElementById("cycleLabel");
const startPauseBtn = document.getElementById("startPauseBtn");
const skipBtn = document.getElementById("skipBtn");
const resetBtn = document.getElementById("resetBtn");
const saveInfo = document.getElementById("saveInfo");
const timerCard = document.getElementById("timerCard");
const dialSvg = document.getElementById("dial");
const dialProgress = document.getElementById("dialProgress");
const dialHandle = document.getElementById("dialHandle");

const DIAL_MINUTES_MIN = 10;
const DIAL_MINUTES_MAX = 90;
const DIAL_RADIUS = 90;
const DIAL_CIRCUMFERENCE = 2 * Math.PI * DIAL_RADIUS;
const STATUS = {
  IDLE: "idle",
  RUNNING: "running",
  PAUSED: "paused"
};
const PHASE = {
  FOCUS: "focus",
  SHORT_BREAK: "short-break",
  LONG_BREAK: "long-break"
};

let currentPayload = null;
let renderInterval = null;
let draftFocusMinutes = 25;
let isDraggingDial = false;
let saveInfoTimeout = null;
const isExtensionContext = Boolean(globalThis.chrome?.runtime?.id && globalThis.chrome?.runtime?.sendMessage);

dialProgress.style.strokeDasharray = String(DIAL_CIRCUMFERENCE);

bootstrap().catch((error) => {
  saveInfo.textContent = `Fehler: ${error.message}`;
});

async function bootstrap() {
  const data = isExtensionContext
    ? await send("GET_STATE")
    : createPreviewPayload();

  applyPayload(data);
  initDialEvents();

  if (renderInterval) clearInterval(renderInterval);
  renderInterval = setInterval(() => {
    if (!currentPayload) return;
    if (!isExtensionContext) {
      tickLocalState();
    }
    renderTimer(currentPayload.state);
  }, 1000);

  if (isExtensionContext) {
    chrome.runtime.onMessage.addListener((message) => {
      if (message?.type === "STATE_UPDATED" && message.payload) {
        applyPayload(message.payload);
      }
    });
  }

  startPauseBtn.addEventListener("click", async () => {
    pulseButton(startPauseBtn);
    await onToggleStartPause();
  });
  skipBtn.addEventListener("click", async () => {
    pulseButton(skipBtn);
    if (!confirmAction("SKIP")) return;
    await dispatchAction("SKIP");
    showSaveInfo("Phase übersprungen");
  });
  resetBtn.addEventListener("click", async () => {
    pulseButton(resetBtn);
    if (!confirmAction("RESET")) return;
    await dispatchAction("RESET");
    showSaveInfo("Timer zurückgesetzt");
  });
}

async function onToggleStartPause() {
  if (!currentPayload) return;
  const { status } = currentPayload.state;

  if (status === STATUS.RUNNING) return dispatchAction("PAUSE");
  if (status === STATUS.PAUSED) return dispatchAction("RESUME");
  return dispatchAction("START");
}

async function dispatchAction(type) {
  if (!currentPayload) return;

  if (isExtensionContext) {
    applyPayload(await send(type));
    return;
  }

  const nextPayload = applyLocalAction(currentPayload, type);
  applyPayload(nextPayload);
}

function applyPayload(payload) {
  currentPayload = payload;

  const { state, settings } = payload;
  draftFocusMinutes = clamp(settings.focusMinutes, DIAL_MINUTES_MIN, DIAL_MINUTES_MAX);
  renderDial(draftFocusMinutes);

  renderMeta(state, settings);
  renderTimer(state);
}

function renderMeta(state, settings) {
  phaseLabel.textContent = phaseText(state.phase);
  cycleLabel.textContent = `Block ${state.cycleInBlock + 1}/${settings.cyclesUntilLongBreak}`;
  renderVisualState(state);

  if (state.status === STATUS.RUNNING) {
    startPauseBtn.textContent = "⏸";
    startPauseBtn.setAttribute("aria-label", "Pause");
    startPauseBtn.setAttribute("title", "Pause");
  } else if (state.status === STATUS.PAUSED) {
    startPauseBtn.textContent = "▶";
    startPauseBtn.setAttribute("aria-label", "Weiter");
    startPauseBtn.setAttribute("title", "Weiter");
  } else {
    startPauseBtn.textContent = "▶";
    startPauseBtn.setAttribute("aria-label", "Start");
    startPauseBtn.setAttribute("title", "Start");
  }
}

function renderVisualState(state) {
  timerCard.classList.remove("state-idle", "state-paused", "state-running-focus", "state-running-break");

  if (state.status === STATUS.RUNNING && state.phase === PHASE.FOCUS) {
    timerCard.classList.add("state-running-focus");
    statusLabel.textContent = "Läuft · Konzentration";
    return;
  }

  if (state.status === STATUS.RUNNING) {
    timerCard.classList.add("state-running-break");
    statusLabel.textContent = "Läuft · Pause";
    return;
  }

  if (state.status === STATUS.PAUSED) {
    timerCard.classList.add("state-paused");
    statusLabel.textContent = "Pausiert";
    return;
  }

  timerCard.classList.add("state-idle");
  statusLabel.textContent = "Bereit";
}

function renderTimer(state) {
  const remainingMs = state.status === "running" && state.endsAt
    ? Math.max(0, state.endsAt - Date.now())
    : state.remainingMs;

  timeLabel.textContent = formatMs(remainingMs);
}

function phaseText(phase) {
  if (phase === "focus") return "Fokus";
  if (phase === "short-break") return "Kurze Pause";
  return "Lange Pause";
}

function formatMs(value) {
  const seconds = Math.ceil(Math.max(0, value) / 1000);
  const minutes = Math.floor(seconds / 60);
  const secs = seconds % 60;
  return `${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
}

function initDialEvents() {
  dialSvg.addEventListener("pointerdown", (event) => {
    if (!currentPayload || currentPayload.state.status === "running") return;
    isDraggingDial = true;
    dialSvg.classList.add("dragging");
    dialSvg.setPointerCapture(event.pointerId);
    updateMinutesFromPointer(event);
  });

  dialSvg.addEventListener("pointermove", (event) => {
    if (!isDraggingDial) return;
    updateMinutesFromPointer(event);
  });

  dialSvg.addEventListener("pointerup", () => {
    const shouldPersist = isDraggingDial;
    isDraggingDial = false;
    dialSvg.classList.remove("dragging");
    if (shouldPersist) persistSettings("Fokusdauer gespeichert");
  });

  dialSvg.addEventListener("pointercancel", () => {
    isDraggingDial = false;
    dialSvg.classList.remove("dragging");
  });
}

function updateMinutesFromPointer(event) {
  const progress = getDialProgressFromPointer(event);
  const minutes = Math.round(DIAL_MINUTES_MIN + progress * (DIAL_MINUTES_MAX - DIAL_MINUTES_MIN));
  draftFocusMinutes = clamp(minutes, DIAL_MINUTES_MIN, DIAL_MINUTES_MAX);
  renderDial(draftFocusMinutes);
  renderDraftTimer();
}

function renderDial(minutes) {
  const progress = (minutes - DIAL_MINUTES_MIN) / (DIAL_MINUTES_MAX - DIAL_MINUTES_MIN);
  const angleFromTop = progress * 360;
  const offset = DIAL_CIRCUMFERENCE * (1 - progress);

  dialProgress.style.strokeDashoffset = String(offset);

  const radians = ((angleFromTop - 90) * Math.PI) / 180;
  const handleX = 120 + DIAL_RADIUS * Math.cos(radians);
  const handleY = 120 + DIAL_RADIUS * Math.sin(radians);
  dialHandle.setAttribute("cx", String(handleX));
  dialHandle.setAttribute("cy", String(handleY));
}

function getDialProgressFromPointer(event) {
  const point = dialSvg.createSVGPoint();
  point.x = event.clientX;
  point.y = event.clientY;

  const ctm = dialSvg.getScreenCTM();
  if (!ctm) return 0;

  const svgPoint = point.matrixTransform(ctm.inverse());
  const dx = svgPoint.x - 120;
  const dy = svgPoint.y - 120;

  let angleFromTopClockwise = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
  if (angleFromTopClockwise < 0) angleFromTopClockwise += 360;

  return angleFromTopClockwise / 360;
}

function renderDraftTimer() {
  timeLabel.textContent = formatMs(draftFocusMinutes * 60 * 1000);
}

function tickLocalState() {
  if (!currentPayload || currentPayload.state.status !== STATUS.RUNNING) return;

  const remainingMs = Math.max(0, currentPayload.state.endsAt - Date.now());
  currentPayload.state.remainingMs = remainingMs;

  if (remainingMs > 0) return;
  currentPayload = applyLocalAction(currentPayload, "SKIP");
}

function applyLocalAction(payload, type) {
  const now = Date.now();
  const state = payload.state;
  const settings = payload.settings;

  if (type === "START") {
    const remainingMs = Math.max(1000, state.remainingMs || getPhaseDurationMs(state.phase, settings));
    return {
      ...payload,
      state: {
        ...state,
        status: STATUS.RUNNING,
        remainingMs,
        endsAt: now + remainingMs
      }
    };
  }

  if (type === "PAUSE") {
    if (state.status !== STATUS.RUNNING) return payload;
    const remainingMs = Math.max(0, state.endsAt - now);
    return {
      ...payload,
      state: {
        ...state,
        status: STATUS.PAUSED,
        remainingMs,
        endsAt: null
      }
    };
  }

  if (type === "RESUME") {
    if (state.status !== STATUS.PAUSED) return payload;
    const remainingMs = Math.max(1000, state.remainingMs || getPhaseDurationMs(state.phase, settings));
    return {
      ...payload,
      state: {
        ...state,
        status: STATUS.RUNNING,
        remainingMs,
        endsAt: now + remainingMs
      }
    };
  }

  if (type === "RESET") {
    const focusMs = settings.focusMinutes * 60 * 1000;
    return {
      ...payload,
      state: {
        status: STATUS.IDLE,
        phase: PHASE.FOCUS,
        cycleInBlock: 0,
        remainingMs: focusMs,
        endsAt: null
      }
    };
  }

  if (type === "SKIP") {
    const { phase, cycleInBlock } = state;
    let nextPhase = PHASE.FOCUS;
    let nextCycleInBlock = cycleInBlock;

    if (phase === PHASE.FOCUS) {
      const progressed = cycleInBlock + 1;
      if (progressed >= settings.cyclesUntilLongBreak) {
        nextPhase = PHASE.LONG_BREAK;
        nextCycleInBlock = 0;
      } else {
        nextPhase = PHASE.SHORT_BREAK;
        nextCycleInBlock = progressed;
      }
    }

    if (phase === PHASE.SHORT_BREAK || phase === PHASE.LONG_BREAK) {
      nextPhase = PHASE.FOCUS;
    }

    const nextRemainingMs = getPhaseDurationMs(nextPhase, settings);
    const keepsRunning = state.status === STATUS.RUNNING;

    return {
      ...payload,
      state: {
        ...state,
        phase: nextPhase,
        cycleInBlock: nextCycleInBlock,
        remainingMs: nextRemainingMs,
        status: keepsRunning ? STATUS.RUNNING : STATUS.PAUSED,
        endsAt: keepsRunning ? now + nextRemainingMs : null
      }
    };
  }

  return payload;
}

function getPhaseDurationMs(phase, settings) {
  if (phase === PHASE.FOCUS) return settings.focusMinutes * 60 * 1000;
  if (phase === PHASE.SHORT_BREAK) return settings.shortBreakMinutes * 60 * 1000;
  return settings.longBreakMinutes * 60 * 1000;
}

function createPreviewPayload() {
  return {
    state: {
      status: "idle",
      phase: "focus",
      cycleInBlock: 0,
      remainingMs: 25 * 60 * 1000,
      endsAt: null
    },
    settings: {
      focusMinutes: 25,
      shortBreakMinutes: 5,
      longBreakMinutes: 15,
      cyclesUntilLongBreak: 4
    }
  };
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

async function persistSettings(message) {
  const settings = {
    focusMinutes: draftFocusMinutes
  };

  if (isExtensionContext) {
    const payload = await send("UPDATE_SETTINGS", { settings });
    applyPayload(payload);
  } else {
    applyPayload({
      ...currentPayload,
      settings: {
        ...currentPayload.settings,
        ...settings
      },
      state: {
        ...currentPayload.state,
        remainingMs: currentPayload.state.phase === PHASE.FOCUS && currentPayload.state.status !== STATUS.RUNNING
          ? settings.focusMinutes * 60 * 1000
          : currentPayload.state.remainingMs
      }
    });
  }

  showSaveInfo(message);
}

function showSaveInfo(message) {
  saveInfo.textContent = message;
  if (saveInfoTimeout) clearTimeout(saveInfoTimeout);
  saveInfoTimeout = setTimeout(() => {
    saveInfo.textContent = "";
  }, 1400);
}

function pulseButton(button) {
  button.classList.add("pressed");
  setTimeout(() => {
    button.classList.remove("pressed");
  }, 120);
}

function confirmAction(actionType) {
  if (typeof globalThis.confirm !== "function") return true;

  if (actionType === "SKIP") {
    return globalThis.confirm("Wirklich zur nächsten Phase springen?");
  }

  if (actionType === "RESET") {
    return globalThis.confirm("Wirklich den Timer zurücksetzen?");
  }

  return true;
}

async function send(type, rest = {}) {
  const response = await chrome.runtime.sendMessage({ type, ...rest });
  if (!response?.ok) {
    throw new Error(response?.error ?? "Unbekannter Fehler");
  }
  return response.payload;
}

/* ── Todo-Liste ───────────────────────────────── */
const todoInput  = document.getElementById("todoInput");
const todoAddBtn = document.getElementById("todoAddBtn");
const todoList   = document.getElementById("todoList");
const todoEmpty  = document.getElementById("todoEmpty");

const TODO_STORAGE_KEY = "focus_pomodoro_todos";
let todos = loadTodos();
renderTodos();

todoAddBtn.addEventListener("click", addTodo);
todoInput.addEventListener("keydown", (e) => {
  if (e.key === "Enter") addTodo();
});

function addTodo() {
  const text = todoInput.value.trim();
  if (!text) return;
  todos.push({ id: Date.now(), text, done: false });
  saveTodos();
  renderTodos();
  todoInput.value = "";
  todoInput.focus();
}

function deleteTodo(id) {
  todos = todos.filter((t) => t.id !== id);
  saveTodos();
  renderTodos();
}

function toggleTodo(id) {
  todos = todos.map((t) => t.id === id ? { ...t, done: !t.done } : t);
  saveTodos();
  renderTodos();
}

function renderTodos() {
  todoList.innerHTML = "";
  todoEmpty.style.display = todos.length === 0 ? "block" : "none";

  for (const todo of todos) {
    const li = document.createElement("li");
    li.className = "todo-item" + (todo.done ? " done" : "");

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.className = "todo-check";
    checkbox.checked = todo.done;
    checkbox.setAttribute("aria-label", `Erledigt: ${todo.text}`);
    checkbox.addEventListener("change", () => toggleTodo(todo.id));

    const span = document.createElement("span");
    span.className = "todo-text";
    span.textContent = todo.text;

    const delBtn = document.createElement("button");
    delBtn.className = "todo-delete";
    delBtn.textContent = "✕";
    delBtn.setAttribute("aria-label", `Löschen: ${todo.text}`);
    delBtn.addEventListener("click", () => deleteTodo(todo.id));

    li.appendChild(checkbox);
    li.appendChild(span);
    li.appendChild(delBtn);
    todoList.appendChild(li);
  }
}

function saveTodos() {
  try {
    localStorage.setItem(TODO_STORAGE_KEY, JSON.stringify(todos));
  } catch (_) { /* Storage nicht verfügbar */ }
}

function loadTodos() {
  try {
    return JSON.parse(localStorage.getItem(TODO_STORAGE_KEY) ?? "[]");
  } catch (_) {
    return [];
  }
}
